{
  "mcpServers": {
    "textbook-api": {
      "command": "npx",
      "args": ["-y", "@codex-mcp/math-textbook"],
      "env": { "TEXTBOOK_API_KEY": "${TEXTBOOK_API_KEY}" }
    },
    "question-bank": {
      "command": "python",
      "args": ["./mcp_servers/question_bank.py"],
      "env": { "QB_DB_PATH": "./data/question_bank.db" }
    }
  }
}